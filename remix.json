{
  "$schema": "./node_modules/remix/schema/remix.json",
  "assets": {
    "basePath": "/assets",
    "mounts": {
      "src": "src",
      "npm": "node_modules"
    },
    "allowFiles": ["src/app/routes.ts", "src/app/**/public/**", "src/editor/**"],
    "allowPackages": [
      "remix",
      "@codemirror/autocomplete",
      "@codemirror/commands",
      "@codemirror/lang-markdown",
      "@codemirror/language",
      "@codemirror/language-data",
      "@codemirror/search",
      "@codemirror/state",
      "@codemirror/view",
      "@lezer/common",
      "@lezer/highlight",
      "@lezer/markdown",
      "katex",
      "turndown",
      "turndown-plugin-gfm"
    ],
    "denyFiles": ["**/*.test.*"],
    "files": {
      "extensions": [".woff2", ".woff", ".ttf"]
    }
  }
}
