---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

/**
 * A screenshot of the app in the reader's theme: `<name>-light.png` and `<name>-dark.png` from
 * `src/assets/shots/` (made by `pnpm docs:shots`). The PNGs are 2× their CSS size; Astro writes 1×
 * and 2× WebP from them.
 */
interface Props {
  name: string
  alt: string
}

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true })
const { name, alt } = Astro.props
const light = shots[`../assets/shots/${name}-light.png`]?.default
const dark = shots[`../assets/shots/${name}-dark.png`]?.default
if (!light || !dark) throw new Error(`No light and dark screenshot named ${name} (run pnpm docs:shots)`)
---

<figure class="shot not-content">
  <Image src={light} alt={alt} width={light.width / 2} densities={[1, 2]} class="dark:sl-hidden" />
  <Image src={dark} alt={alt} width={dark.width / 2} densities={[1, 2]} class="light:sl-hidden" />
</figure>

<style>
  .shot {
    margin-block: 1.5rem;
  }
  /* No `display` here: it would beat Starlight's layered light:/dark:sl-hidden classes. */
  .shot img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    box-shadow: var(--sl-shadow-md);
  }
</style>
