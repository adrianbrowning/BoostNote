---
/** A shortcut as key caps: `⇧⌘N` on macOS, `Ctrl+Shift+N` on Windows and Linux. */
interface Props {
  keys: readonly string[]
  style: 'mac' | 'pc'
}

const { keys, style } = Astro.props
---

<span class="keys">
  {keys.map((key, index) => (
    <>
      {style === 'pc' && index > 0 && '+'}
      <kbd>{key}</kbd>
    </>
  ))}
</span>

<style>
  .keys {
    white-space: nowrap;
  }
</style>
