{
  "name": "boostnote",
  "productName": "Boostnote",
  "version": "0.17.0",
  "description": "Note-taking app for programmers",
  "license": "GPL-3.0",
  "author": "Junyoung Choi <fluke8259@gmail.com> (https://github.com/Rokt33r)",
  "homepage": "https://github.com/adrianbrowning/BoostNote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianbrowning/BoostNote.git"
  },
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc",
    "test": "vitest run",
    "build": "tsc && node --import remix/node-tsx scripts/verify-assets.ts",
    "dist": "pnpm build && electron-builder --publish never",
    "migrate": "node --import remix/node-tsx src/migrate/cli.ts",
    "test:e2e": "playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "cson-parser": "^4.0.9",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.2.0",
    "remix": "3.0.0",
    "sanitize-html": "^2.18.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
