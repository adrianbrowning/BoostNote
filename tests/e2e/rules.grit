language js

or {
  `getComputedStyle` as $use where {
    register_diagnostic(span=$use, message="Read computed styles with expect(locator).toHaveCSS(), which retries until the style settles.")
  },
  `$target.locator($selector)` where {
    $selector <: or {
      `'..'`,
      `".."`
    },
    register_diagnostic(span=$selector, message="Locate the element by role, accessible name or a data-* hook instead of DOM traversal.")
  }
}
